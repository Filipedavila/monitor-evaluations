{
  "name": "monitor-server-worker",
  "version": "2.0.0",
  "description": "Access Monitor Suite backend application server Version 2 Workers",
  "author": "Filipe Dávila <57022557+Filipedavila@users.noreply.github.com>",
  "contributors": [
    "Filipe Dávila <57022557+Filipedavila@users.noreply.github.com>"
  ],
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "typeorm": "typeorm-ts-node-commonjs",
    "build": "cross-env NODE_ENV=production tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/worker.js",
    "start:dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register --watch src/worker.ts",
    "start:debug": "cross-env NODE_ENV=development node --inspect -r ts-node/register -r tsconfig-paths/register src/worker.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/worker.js",
    "start:local": "cross-env NODE_ENV=development node dist/worker.js",
    "lint": "eslint '{src,test}/**/*.ts' --fix",
    "test": "jest -c jest.config.js --detectOpenHandles --no-cache",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "graph": "madge --image graph.png --extensions ts --ts-config tsconfig.json src/worker.ts",
    "graph:check": "madge --circular --extensions ts --ts-config tsconfig.json src/worker.ts",
    "graph:debug": "npm run graph:check -- --debug",
    "graph:summary": "madge --summary --extensions ts --ts-config tsconfig.json src/worker.ts",
    "migration:generate": "npm run typeorm:base -- migration:generate -d src/data-source.ts migrations/",
    "migration:run": "npm run typeorm:base -- migration:run -d src/data-source.ts",
    "typeorm:base": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:revert": "npm run typeorm:base -- migration:revert -d src/data-source.ts",
    "schema:drop": "npm run typeorm:base -- schema:drop -d src/data-source.ts",
    "check:unused": "npx knip",
    "security:scan": "semgrep scan --config .semgrep.yml",
    "prepare": "husky"
  },
  "dependencies": {
    "@a12e/accessmonitor-rulesets": "2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@qualweb/act-rules": "^0.8.5",
    "@qualweb/best-practices": "0.7.13",
    "@qualweb/core": "^0.9.5",
    "@qualweb/counter": "0.3.5",
    "@qualweb/wcag-techniques": "0.4.8",
    "puppeteer": "^22.12.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "bullmq": "^5.76.4",
    "dotenv": "^18.0.4",
    "ioredis": "^5.11.1",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "pg": "^8.21.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "js-yaml": "^4.1.0",
    "multer": "^2.0.0-rc.4",
    "trim": "^0.0.3",
    "uuid": "^14.0.0"
  }
}
