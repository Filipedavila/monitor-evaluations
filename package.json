{
  "name": "monitor-server-worker",
  "version": "2.0.0",
  "description": "Access Monitor Suite backend application server Version 2 Workers",
  "author": "Filipe Dávila <57022557+Filipedavila@users.noreply.github.com>",
  "contributors": [
    "Filipe Dávila <57022557+Filipedavila@users.noreply.github.com>"
  ],
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "cross-env NODE_ENV=production tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/main.ts",
    "dev": "concurrently \"npm run watch:tsc\" \"npm run watch:run\"",
    "watch:tsc": "tsc-watch -p tsconfig.build.json --onSuccess \"tsc-alias -p tsconfig.build.json\"",
    "watch:run": "nodemon dist/worker.js",
    "lint": "eslint '{src,test}/**/*.ts' --fix",
    "test": "jest -c jest.config.js --detectOpenHandles --no-cache",
    "test:watch": "jest -c jest.config.js --watch",
    "test:cov": "jest -c jest.config.js --coverage",
    "test:integration": "jest -c jest.integration.config.js --runInBand --detectOpenHandles",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@a12e/accessmonitor-rulesets": "2.0.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@qualweb/act-rules": "^0.8.5",
    "@qualweb/best-practices": "0.7.13",
    "@qualweb/core": "file:./qualweb-core-0.9.1.tgz",
    "@qualweb/counter": "0.3.5",
    "@qualweb/playwright-driver": "file:./qualweb-playwright-driver-1.0.0.tgz",
    "@qualweb/wcag-techniques": "0.4.8",
    "bullmq": "^6.3.12",
    "bullmq-otel": "^2.0.1",
    "dotenv": "^18.0.4",
    "fingerprint-generator": "^2.1.88",
    "fingerprint-injector": "^2.1.88",
    "ioredis": "^5.11.1",
    "puppeteer": "^22.12.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.18",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "nodemon": "^3.1.14",
    "pg": "^8.21.0",
    "prettier": "^3.8.1",
    "testcontainers": "^12.2.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.9.10",
    "tsc-watch": "^7.2.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "js-yaml": "^4.1.0",
    "multer": "^2.0.0-rc.4",
    "trim": "^0.0.3",
    "uuid": "^14.0.0"
  }
}
